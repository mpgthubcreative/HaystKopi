# Copy to ".env" for local `netlify dev` testing — never commit the real ".env".
# In production these are set in Netlify: Site settings > Environment variables.
#
# Get these three values from Firebase Console > Project settings >
# Service accounts > Generate new private key. That downloads a JSON file —
# copy the matching fields from it below (do not commit that JSON file).

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Keep the literal \n sequences — the function code converts them to real
# newlines at runtime. Wrap the whole value in quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n-----END PRIVATE KEY-----\n"

# Google Cloud Console > APIs & Services > Credentials > Create API key.
# Enable the "Distance Matrix API" for this key, then (Edit key > API
# restrictions) restrict it to ONLY that API. This key is used server-side
# only (netlify/functions/lib/delivery.js) — never expose it in checkout.js,
# checkout-config.js, any public HTML, or Firestore.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# The same value already in firebase/firebase-config.js's storageBucket
# field (e.g. "your-project-id.firebasestorage.app" or
# "your-project-id.appspot.com" for older projects) — the Admin SDK can't
# infer this on Netlify the way it can on native GCP compute, so it must be
# spelled out explicitly. Needed for payment-proof upload/retrieval
# (Phase 7). No separate credential — reuses the three Firebase vars above.
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

# No new API key needed for OCR — Google Cloud Vision is called using the
# SAME service account as FIREBASE_CLIENT_EMAIL/FIREBASE_PRIVATE_KEY above.
# You only need to enable the Vision API for this project once:
# Google Cloud Console > APIs & Services > Library > "Cloud Vision API" > Enable.

# Owner email notifications (new order / payment proof submitted) — sent
# via Resend's REST API (netlify/functions/lib/order-notifications.js).
# Server-side only; never referenced by any frontend file. Get the API key
# from resend.com > API Keys. ORDER_NOTIFICATION_FROM_EMAIL must be an
# address on a domain you've verified in Resend (resend.com > Domains) —
# their sandbox/test domain works for local testing but will not deliver
# to arbitrary real inboxes.
RESEND_API_KEY=re_your_resend_api_key
ORDER_NOTIFICATION_EMAIL=owner@example.com
ORDER_NOTIFICATION_FROM_EMAIL=orders@yourverifieddomain.com

# Base URL used to build the "View Order in Admin" link in notification
# emails (lib/order-notifications.js). No trailing slash. Falls back to
# the known production domain if unset, so this is optional in production
# but worth setting explicitly for a staging/branch deploy.
SITE_URL=https://hayst-kopi.netlify.app
